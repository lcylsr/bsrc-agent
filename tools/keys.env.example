# 复制到以下任一位置后填写(不要提交 git):
#   %USERPROFILE%\.config\srccop\keys.env
#   %USERPROFILE%\.config\space-recon\keys.env
#   (不推荐) tools/keys.env  — 若使用请确保 .gitignore
#
# 也可用系统环境变量同名覆盖。

# FOFA
# - 官网 fofa.info: 需要 FOFA_EMAIL + FOFA_KEY
# - 代理 bdziyi.com: 需 FOFA_COOKIE（登录 https://bdziyi.com/hygj/ssyq.html 后从浏览器复制 Cookie 头）
#   FOFA_BASE=https://bdziyi.com/hygj/ssyq.html；cookie 会过期，失效时重新复制
FOFA_EMAIL=
FOFA_KEY=
FOFA_BASE=https://bdziyi.com/hygj/ssyq.html
FOFA_COOKIE=

HUNTER_KEY=
QUAKE_TOKEN=
# 可选: GitHub Code Search
GITHUB_TOKEN=

# ─────────────────────────────────────────────
# TSecBench 跑分平台（BSRC Agent+ 挑战赛评测）
# 在 TSecBench 平台创建跑分任务后下发；token 按任务隔离，一任务一个。
# 配套: bash tools/run.sh benchmark-api list|start|hint|submit|close
# 注意: start 返回的题目容器地址需连接靶场 SSLVPN 后才可访问
BENCHMARK_BASE_URL=
BENCHMARK_TOKEN=
